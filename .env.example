# Copy to .env and fill in for local Netlify dev
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Maps Distance Matrix — live commute times
GOOGLE_MAPS_API_KEY=

# Web push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Woodhouse — register all your apps (preferred)
# WOODHOUSE_NODES=[{"id":"easy-supply-co","displayName":"Easy Supply Co.","nodeType":"commerce","baseUrl":"https://..."}]

WOODHOUSE_EASY_SUPPLY_URL=
WOODHOUSE_FAMILY_PURPOSE_URL=
FAMILY_PURPOSE_BACKUP_KEY=
# Optional: browser uploads from Family Purpose only (e.g. https://your-family-purpose.netlify.app). Omit for server-to-server only.
# FAMILY_PURPOSE_BACKUP_ALLOWED_ORIGIN=
WOODHOUSE_TIMEZONE=America/Los_Angeles
# Built-in ECS Network roadmap node ($BAY / festival milestones). Set to off to hide.
# WOODHOUSE_ECS_ROADMAP=off
# Monthly revenue goal shown on the roadmap node (start small; ladder climbs to $100K/mo)
# WOODHOUSE_REVENUE_GOAL=1000

# Free key from https://finnhub.io/register — live stock quotes & IPO calendar
FINNHUB_API_KEY=

# Vantage Point — lets Iris's briefing lead with the real daily paper instead
# of her own summary (falls back automatically if this never arrives). The
# separate job that builds/publishes that paper should POST its edition.json
# to https://<iris-site>/api/vantage-paper with header "X-Vantage-Key: <this>"
# as its last step, once it's published.
VANTAGE_PAPER_KEY=
# Which IRIS account (by Google sign-in email) the paper gets attached to.
VANTAGE_ACCOUNT_EMAIL=
# Optional: Bay Area ship markers on the Pulse map (God's Eye / Vitals)
# AISSTREAM_API_KEY=

# Easy Supply — Shopify Admin API (read-only in IRIS: products, open orders, inventory)
# SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# SHOPIFY_ADMIN_ACCESS_TOKEN=
# SHOPIFY_STOREFRONT_URL=https://your-store.com

# Optional local tools (not wired into Alfred): Voicebox on localhost for cloned Iris TTS;
# n8n on your server for automation — see docs/SERVER_PLAN.md

# Iris conversation brain (required for /api/ask)
ANTHROPIC_API_KEY=
