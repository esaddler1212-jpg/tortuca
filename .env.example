# ============================================================================
# ECS Network Platform — root env reference
# ----------------------------------------------------------------------------
# Copy the relevant block into each app's own .env.local file:
#   apps/easy-supply-co/.env.local
#   apps/ecs-network/.env.local
#   apps/tortuca/.env.local
#
# Every integration is OPTIONAL for local development. When a key is missing
# the app falls back to bundled sample data so it still boots and renders.
# ============================================================================

# --- Supabase (shared backend / Tortuca) -----------------------------------
# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only (NEVER expose to the browser) — used by API routes & admin
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Shopify Storefront API (Easy Supply Co) --------------------------------
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=your-storefront-access-token
SHOPIFY_STOREFRONT_API_VERSION=2024-07

# --- Stripe (payments) ------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Daily Brief (personal dashboard) ---------------------------------------
# Your phone calendar's private iCal/ICS URL (Apple/Google "secret" iCal link).
CALENDAR_ICS_URL=
# Gmail access token for priority-email scanning (OAuth; sample used if empty).
GMAIL_ACCESS_TOKEN=

# --- Site URLs (cross-linking between apps) ---------------------------------
NEXT_PUBLIC_STORE_URL=http://localhost:3001
NEXT_PUBLIC_NETWORK_URL=http://localhost:3002
NEXT_PUBLIC_ADMIN_URL=http://localhost:3003
NEXT_PUBLIC_BRIEF_URL=http://localhost:3004
