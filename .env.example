# Copy to .env and fill in for local Netlify dev
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Easy Supply Co. Woodhouse store node (optional — or set in Alfred Settings)
WOODHOUSE_EASY_SUPPLY_URL=

# Family Purpose calendar node (optional — or use cloud backup on same Netlify site)
WOODHOUSE_FAMILY_PURPOSE_URL=
FAMILY_PURPOSE_BACKUP_KEY=
WOODHOUSE_TIMEZONE=America/Los_Angeles
