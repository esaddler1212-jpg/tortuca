# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Comma-separated Clerk user IDs allowed to use /admin
ADMIN_USER_IDS=

# App URL for Stripe redirects (Netlify sets URL automatically)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (https://dashboard.stripe.com)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PREMIUM=

# Netlify Database — auto-set on Netlify when @netlify/database is installed
NETLIFY_DB_URL=
