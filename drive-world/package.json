{
  "name": "drive-world",
  "version": "0.1.0",
  "private": true,
  "description": "City Nights — open-world Bay Area night driving (PlayCanvas + Ammo)",
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node scripts/smoke-boot.mjs",
    "test:wiring": "node scripts/check-tokyo-wiring.mjs",
    "test:playtest": "node scripts/playtest-browser.mjs",
    "test:tokyo": "npm run test:wiring && node scripts/playtest-tokyo.mjs",
    "test:city-nights": "npm run test:wiring && npm run test:smoke && npm run test:playtest && npm run test:tokyo"
  },
  "dependencies": {
    "@netlify/blobs": "^8.2.0",
    "@netlify/functions": "^2.8.2",
    "playcanvas": "^2.23.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "puppeteer-core": "^24.43.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  }
}
