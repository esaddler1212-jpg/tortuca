    },
    {
      "id": "freepd",
      "kavexTier": "free",
      "title": "FreePD",
      "url": "https://freepd.com",
      "licenseNote": "Public domain music",
      "use": ["music-ambient"]
    },
    {
      "id": "gamesounds-xyz",
      "kavexTier": "free",
      "title": "GameSounds.xyz",
      "url": "https://gamesounds.xyz",
      "licenseNote": "Check per archive",
