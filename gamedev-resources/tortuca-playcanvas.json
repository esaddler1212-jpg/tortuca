      "licenseNote": "CC0 on most packs; already used for Car Kit in drive-world",
      "use": ["3d-vehicles", "3d-city", "audio-ui"],
      "install": "tools/gamedev-resources/install-free-packs.sh"
    },
    {
      "id": "poly-pizza",
      "kavexTier": "free",
      "title": "Poly Pizza",
      "url": "https://poly.pizza",
      "licenseNote": "Creative Commons; check per model",
      "use": ["3d-props", "low-poly-heroes"]
    },
    {
      "id": "polyhaven",
      "kavexTier": "free",
      "title": "Poly Haven",
      "url": "https://polyhaven.com",
      "licenseNote": "CC0 HDRIs, textures, models",
      "use": ["pbr-sky", "materials", "hero-props"]
    },
    {
      "id": "ambientcg",
