{
  "catalogVersion": 2,
  "upstream": "https://github.com/public-apis/public-apis",
  "selectionRules": "Prefer Auth=No, HTTPS=Yes, CORS=Yes for browser clients; secrets via Netlify only.",
  "alreadyInTortuca": [
    {
      "id": "open-meteo",
      "url": "https://open-meteo.com/",
      "use": "IRIS Pulse, regional weather, drive-world sky mood",
      "where": ["netlify/functions/_pulse.ts", "src/lib/weather.ts"]
    },
    {
      "id": "open-meteo-geocoding",
      "url": "https://open-meteo.com/en/docs/geocoding-api",
      "use": "City search",
      "where": ["src/lib/weather.ts"]
    },
    {
      "id": "open-meteo-air-quality",
      "url": "https://open-meteo.com/en/docs/air-quality-api",
      "use": "Pulse vitals AQI",
      "where": ["netlify/functions/_pulse.ts"]
    },
    {
      "id": "usgs-earthquake",
      "url": "https://earthquake.usgs.gov/fdsnws/event/1/",
      "use": "Bay Area quake list in Pulse",
      "where": ["netlify/functions/_pulse.ts"]
    },
    {
      "id": "nws-alerts",
      "url": "https://www.weather.gov/documentation/services-web-api",
      "use": "Active weather alerts at user point",
      "where": ["netlify/functions/_pulse.ts"]
    },
    {
      "id": "adsb-lol",
      "url": "https://api.adsb.lol/",
      "use": "Local flight tracks for Pulse / God's Eye context",
      "where": ["netlify/functions/_pulse.ts"]
    },
    {
      "id": "caltrans-cctv",
      "url": "https://cwwp2.dot.ca.gov/",
      "use": "D4 traffic cameras near Vallejo",
      "where": ["netlify/functions/_pulse.ts"]
    },
    {
      "id": "wfigs-fires",
      "url": "https://data-nifc.opendata.arcgis.com/",
      "use": "Wildfire incidents near user",
      "where": ["netlify/functions/_pulse.ts"]
    },
    {
      "id": "finnhub",
      "url": "https://finnhub.io/docs/api",
      "use": "Stocks panel + Iris watchlist (session-gated)",
      "where": ["netlify/functions/stocks.ts", "netlify/functions/_stocks-config.ts"]
    }
  ],
  "entries": [
    {
      "id": "3dtexel",
      "url": "https://3dtexel.com/developers/",
      "auth": "none",
      "cors": true,
      "use": ["cc0-model-search", "character-research-assets"],
      "target": "flight-nemulator"
    },
    {
      "id": "open5e",
      "url": "https://open5e.com/",
      "auth": "none",
      "cors": true,
      "use": ["mission-text", "rpg-easter-eggs"],
      "target": "flight-nemulator"
    },
    {
      "id": "jokeapi",
      "url": "https://sv443.net/jokeapi/v2/",
      "auth": "none",
      "cors": true,
      "use": ["loading-banter"],
      "target": "both"
    },
    {
      "id": "freetogame",
      "url": "https://www.freetogame.com/api-doc",
      "auth": "none",
      "cors": true,
      "use": ["manifest-suggestions"],
      "target": "flight-nemulator"
    },
    {
      "id": "gamerpower",
      "url": "https://www.gamerpower.com/api-read",
      "auth": "none",
      "cors": true,
      "use": ["giveaway-widget"],
      "target": "both"
    },
    {
      "id": "deckofcards",
      "url": "https://deckofcardsapi.com/",
      "auth": "none",
      "cors": "unknown",
      "use": ["minigame-prototype"],
      "target": "both"
    },
    {
      "id": "nasa-power",
      "url": "https://power.larc.nasa.gov/docs/",
      "auth": "none",
      "cors": true,
      "use": ["solar-flare-sky-tint"],
      "target": "flight-nemulator"
    },
    {
      "id": "aviationweather",
      "url": "https://www.aviationweather.gov/dataserver",
      "auth": "none",
      "cors": false,
      "use": ["gods-eye-flight-context"],
      "target": "server-proxy-only"
    },
    {
      "id": "pirate-weather",
      "url": "https://pirateweather.readthedocs.io/",
      "auth": "none",
      "cors": true,
      "use": ["backup-weather"],
      "target": "drive-world"
    },
    {
      "id": "logoapi",
      "url": "https://logoapi.sh/docs",
      "auth": "none",
      "cors": true,
      "use": ["thumbnail-mockup-logos", "client-brand-chips"],
      "target": "client-ok"
    },
    {
      "id": "seller-fee",
      "url": "https://seller-fee-api.narwhalapis.workers.dev",
      "auth": "none",
      "cors": true,
      "use": ["revenue-os-net-payout-after-stripe-paypal"],
      "target": "server-proxy-only"
    },
    {
      "id": "spaceflight-news",
      "url": "https://spaceflightnewsapi.net",
      "auth": "none",
      "cors": true,
      "use": ["vitals-easter-egg", "scout-space"],
      "target": "scout-only"
    }
  ],
  "backlog": [
    {
      "id": "fred",
      "url": "https://fred.stlouisfed.org/docs/api/fred/",
      "auth": "apiKey",
      "cors": true,
      "use": "Macro one-liner in morning brief",
      "target": "iris-proxy",
      "module": "vitals"
    },
    {
      "id": "marketaux",
      "url": "https://www.marketaux.com/",
      "auth": "apiKey",
      "cors": true,
      "use": "News tagged to watchlist tickers",
      "target": "iris-proxy",
      "module": "hub"
    },
    {
      "id": "fiscaldata-treasury",
      "url": "https://fiscaldata.treasury.gov/api-documentation/",
      "auth": "none",
      "cors": "unknown",
      "use": "Optional macro context",
      "target": "iris-proxy",
      "module": "team"
    },
    {
      "id": "the-calendar",
      "url": "https://the-calendar.net/api/",
      "auth": "none",
      "cors": true,
      "use": "Holiday JSON backup",
      "target": "client-ok",
      "module": "plan"
    },
    {
      "id": "exchangerate-dev",
      "url": "https://exchangerate.dev/docs",
      "auth": "none",
      "cors": "unknown",
      "use": "International thumbnail clients — display only",
      "target": "server-proxy-only",
      "module": "hub"
    }
  ],
  "avoidInClient": [
    {
      "id": "marvel-api",
      "reason": "Trademarked character names; we use homage codenames only"
    },
    {
      "id": "comicvine",
      "reason": "Same; lore inspiration only off-device"
    },
    {
      "id": "raw-crypto-exchange-apis",
      "reason": "Finnhub covers watchlist; avoid duplicating keys and Iris quota advice on 100+ exchange entries"
    }
  ]
}