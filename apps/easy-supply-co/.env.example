# Easy Supply Co — copy to .env.local and fill in as needed.
# All values are OPTIONAL for local dev; the app falls back to sample data.

# Supabase (shared auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Shopify Storefront API (product catalog)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2024-07

# Stripe (checkout)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Cross-links
NEXT_PUBLIC_NETWORK_URL=http://localhost:3002
NEXT_PUBLIC_STORE_URL=http://localhost:3001
