# Tortuca (admin) — copy to .env.local and fill in as needed.
# Without Supabase, the admin uses an in-memory dev store (data resets on
# restart) so the dashboard and CRUD remain fully functional locally.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cross-links
NEXT_PUBLIC_STORE_URL=http://localhost:3001
NEXT_PUBLIC_NETWORK_URL=http://localhost:3002
NEXT_PUBLIC_ADMIN_URL=http://localhost:3003
