# ECS Network — copy to .env.local and fill in as needed.
# All values are OPTIONAL for local dev; the app falls back to sample data.

# Supabase (shared auth + blog CMS + contact form)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cross-links
NEXT_PUBLIC_STORE_URL=http://localhost:3001
NEXT_PUBLIC_NETWORK_URL=http://localhost:3002
