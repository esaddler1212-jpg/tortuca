# Daily Brief — copy to .env.local and fill in as needed.
# Everything is OPTIONAL; without keys the brief renders with sample data.

# Supabase (persists tasks + trackers; otherwise in-memory, resets on restart)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google (Calendar + Gmail) via OAuth ------------------------------------
# Preferred live source. Create an OAuth 2.0 Web client in Google Cloud Console
# with the redirect URI below, enable the Calendar API + Gmail API, and add the
# scopes calendar.readonly + gmail.readonly. Then "Connect Google" in the app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3004/api/google/callback
NEXT_PUBLIC_BRIEF_URL=http://localhost:3004

# Calendar fallback: a phone calendar's private iCal/ICS URL (used when Google
# is not connected). Apple/Google calendars both expose a secret .ics link.
CALENDAR_ICS_URL=

# Where to read ECS action items (Tortuca backend)
NEXT_PUBLIC_ADMIN_URL=http://localhost:3003
