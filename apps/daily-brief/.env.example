# Daily Brief — copy to .env.local and fill in as needed.
# Everything is OPTIONAL; without keys the brief renders with sample data.

# Supabase (persists tasks + trackers; otherwise in-memory, resets on restart)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Calendar: your phone calendar's private iCal/ICS URL.
#  - Apple Calendar: Calendar → share a calendar → Public/secret .ics URL
#  - Google Calendar: Settings → <calendar> → "Secret address in iCal format"
CALENDAR_ICS_URL=

# Priority email (Gmail). Real integration requires OAuth; placeholder for now.
GMAIL_ACCESS_TOKEN=

# Where to read ECS action items (Tortuca backend)
NEXT_PUBLIC_ADMIN_URL=http://localhost:3003
