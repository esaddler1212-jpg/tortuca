{
  "name": "flight-nemulator",
  "version": "0.1.0",
  "private": true,
  "description": "Flight Nemulator — homage hero flight sandbox with district home bases and destructible cities",
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "build:hero-glb": "node scripts/build-hero-glbs.mjs",
    "build:nemesis-glb": "node scripts/build-nemesis-glbs.mjs",
    "build:glb": "npm run build:hero-glb && npm run build:nemesis-glb",
    "build": "npm run build:glb && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node scripts/smoke-boot.mjs",
    "test:playtest": "node scripts/playtest-battleworld.mjs",
    "test:battleworld": "npm run test:smoke && npm run test:playtest"
  },
  "dependencies": {
    "@netlify/blobs": "^10.0.10",
    "@netlify/functions": "^2.8.2",
    "playcanvas": "^2.23.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "puppeteer-core": "^24.43.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  }
}
